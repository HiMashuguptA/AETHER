# AETHER environment variables. Names and explanations only: never commit real values.
# Local: copy to .env.local (git-ignored) and export, or pass inline. Vercel: Project → Settings →
# Environment Variables, scoped to Preview (staging) or Production. Nothing here is read by the browser.

# --- required ---
# Postgres connection string. Use a separate database for each environment.
DATABASE_URL=
# Random string of 32+ characters that signs sessions. Generate: openssl rand -base64 48. Different per environment.
AUTH_SECRET=

# --- app ---
# Public origin of the app, no trailing slash. On Vercel it is worked out from the deployment, so leave it unset there
# unless you use a custom domain.
APP_URL=http://localhost:8787
# Extra origins allowed to call the API with cookies, comma separated. Normally empty.
ALLOWED_ORIGINS=
# Overrides the environment name: production | preview | development | test. Normally unset (Vercel sets VERCEL_ENV).
AETHER_ENV=

# --- email (sign-up confirmation, password reset, invitations) ---
# Resend API key. Without it no email is sent.
RESEND_API_KEY=
# Sender. With Resend's test sender, mail only reaches the Resend account owner; verify a domain for real use.
EMAIL_FROM=AETHER <onboarding@resend.dev>
# Staging and local only: show confirmation links in the app when there is no email provider. Ignored in production.
DEV_OUTBOX=false
# Leave empty: sign-up asks people to confirm their email only when an email can reach them
# (RESEND_API_KEY set, or the staging outbox on). Set true or false to override.
AUTH_REQUIRE_EMAIL_VERIFICATION=

# --- Google sign-in (optional; the button appears only when both are set) ---
# Google Cloud Console → Credentials → OAuth client (Web). Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Muse (AI) ---
# Muse needs one provider key. Free tiers that need no card (create the key yourself; never paste it in chat):
#   GROQ_API_KEY    console.groq.com → API Keys. Default model openai/gpt-oss-120b.
#   GEMINI_API_KEY  aistudio.google.com → Get API key. Default model gemini-2.5-flash.
# With no key, Muse runs a clearly labelled development fallback that is not AI.
GROQ_API_KEY=
GEMINI_API_KEY=
# groq | gemini | openai (any OpenAI-compatible API, e.g. OpenRouter with MUSE_BASE_URL) | anthropic | gateway | fallback.
# Unset or auto: the first key present decides, in the order above.
MUSE_PROVIDER=
# Override the provider's default model id.
MUSE_MODEL=
OPENAI_API_KEY=
# OpenAI-compatible base URL, e.g. https://openrouter.ai/api/v1
MUSE_BASE_URL=
ANTHROPIC_API_KEY=
# Vercel AI Gateway (needs a card on the Vercel account, even for its free credit). On Vercel no key is stored.
AI_GATEWAY_API_KEY=
# Safety limits. Requests stop when a day's estimated spend reaches these (USD). Free tiers are still costed at the
# provider's paid list price, so the limits keep working if billing is ever switched on for the key.
MUSE_DAILY_BUDGET_USD=2
MUSE_WORKSPACE_DAILY_BUDGET_USD=0.5
MUSE_TIMEOUT_MS=25000
# Price per million tokens for cost estimates. Leave empty to use the provider's list price.
MUSE_PRICE_INPUT_PER_M=
MUSE_PRICE_OUTPUT_PER_M=

# --- file storage ---
# vercel-blob | local | none. Unset: vercel-blob when the token is present, local in development and tests.
STORAGE_PROVIDER=
# Read-write token of a PRIVATE Vercel Blob store (Vercel → Storage → Blob → the store → .env.local tab).
BLOB_READ_WRITE_TOKEN=
LOCAL_STORAGE_DIR=.data/uploads

# --- publishing ---
# builtin serves published pages from this app at /p/<address>; it needs nothing else.
# subdomain (<address>.<root domain>) is implemented as an adapter but refuses to run until a domain you own has a
# wildcard DNS record pointed at the host and is added to the hosting project.
PUBLISH_ADAPTER=builtin
PUBLISH_ROOT_DOMAIN=
PUBLISH_WILDCARD_READY=false

# --- scheduled cleanup ---
# Long random value. Vercel Cron sends it as a bearer token to /api/cron/cleanup once a day (production only).
CRON_SECRET=

# --- share cards and sitemap (build time) ---
# Public address used in share tags, robots.txt and sitemap.xml. Unset on Vercel: the production domain.
SITE_URL=
